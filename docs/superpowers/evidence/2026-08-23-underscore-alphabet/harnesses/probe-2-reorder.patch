+// ===== PROBE 2 HOOK (throwaway) =====
+#[doc(hidden)]
+pub mod probe {
+    use std::sync::atomic::{AtomicBool, AtomicU64, AtomicUsize, Ordering::SeqCst};
+    /// 0 = ship. 3 = reorder: choose `_` before the splice and suppress it.
+    pub static MODE: AtomicU64 = AtomicU64::new(0);
+    pub static PARENT_UNDER: AtomicBool = AtomicBool::new(false);
+    /// Runs where `_` was chosen, and runs where a collision existed but the
+    /// flanks refused `_` (so the splice still had to fire).
+    pub static CHOSE: AtomicUsize = AtomicUsize::new(0);
+    pub static REFUSED: AtomicUsize = AtomicUsize::new(0);
+    pub fn reset(mode: u64) {
+        MODE.store(mode, SeqCst);
+        PARENT_UNDER.store(false, SeqCst);
+        CHOSE.store(0, SeqCst);
+        REFUSED.store(0, SeqCst);
+    }
+    pub fn counts() -> (usize, usize) {
+        (CHOSE.load(SeqCst), REFUSED.load(SeqCst))
+    }
+}
