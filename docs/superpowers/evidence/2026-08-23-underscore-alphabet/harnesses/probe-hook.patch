+// ===== PROBE HOOK (throwaway; see docs/superpowers/evidence/2026-08-23-underscore-alphabet) =====
+#[doc(hidden)]
+pub mod probe {
+    use super::{escape, Flank};
+    use std::sync::atomic::{AtomicU64, AtomicUsize, Ordering::SeqCst};
+    use std::sync::Mutex;
+
+    /// 0 = ship behaviour (`*`/`**`). 1 = assignment mode (consume BITS).
+    /// 2 = rule mode (`_` iff neither flank is alphanumeric).
+    pub static MODE: AtomicU64 = AtomicU64::new(0);
+    pub static BITS: AtomicU64 = AtomicU64::new(0);
+    pub static IDX: AtomicUsize = AtomicUsize::new(0);
+    /// One entry per emission: (is_strong, before_class, after_class, chose_underscore).
+    pub static LOG: Mutex<Vec<(u8, u8, u8, u8)>> = Mutex::new(Vec::new());
+
+    fn cls(f: Flank) -> u8 {
+        match f {
+            Flank::Space => 0,
+            Flank::Punct => 1,
+            Flank::Other => 2,
+        }
+    }
+
+    pub fn reset(mode: u64, bits: u64) {
+        MODE.store(mode, SeqCst);
+        BITS.store(bits, SeqCst);
+        IDX.store(0, SeqCst);
+        LOG.lock().unwrap().clear();
+    }
+
+    pub fn log() -> Vec<(u8, u8, u8, u8)> {
+        LOG.lock().unwrap().clone()
+    }
+
+    pub(super) fn markup(d: escape::Delim, before: Flank, after: Flank) -> &'static str {
+        let strong = d == escape::Delim::Strong;
+        let under = match MODE.load(SeqCst) {
+            1 => {
+                let i = IDX.fetch_add(1, SeqCst);
+                i < 64 && (BITS.load(SeqCst) >> i) & 1 == 1
+            }
+            2 => before != Flank::Other && after != Flank::Other,
+            _ => false,
+        };
+        LOG.lock()
+            .unwrap()
+            .push((strong as u8, cls(before), cls(after), under as u8));
+        match (strong, under) {
+            (false, false) => "*",
+            (true, false) => "**",
+            (false, true) => "_",
+            (true, true) => "__",
+        }
+    }
+}
